; ═══════════ 🌍 CURRENCY STRENGTH (FIXO) ═══════════
InpCS_CalcPeriod=24||24||12||48||N
InpCS_Smoothing=5||5||3||10||N
InpCS_ShowPercent=true||false||0||true||N

; ═══════════════════════════════════════════════════════════════════
; INSTRUÇÕES DE USO:
; ═══════════════════════════════════════════════════════════════════
;
; 1. BACKTEST INICIAL (Validação)
;    - Período: 1 ano (dados de qualidade)
;    - Todos parâmetros em PADRÃO (valores da esquerda)
;    - Objetivo: Verificar se estratégia é viável
;    - Esperado: Win Rate 45%+, PF 1.3+, DD <20%
;
; 2. OTIMIZAÇÃO FASE 1 (SL/TP)
;    - Ativar Y apenas em:
;      * InpStopLossBuy, InpTakeProfitBuy
;      * InpStopLossSell, InpTakeProfitSell
;    - Fixar todo resto
;    - Objetivo: Encontrar R:R ótimo
;    - Critério: Custom Max (Balance + DrawdownPct)
;    - Tempo esperado: 30-60 minutos
;
; 3. OTIMIZAÇÃO FASE 2 (Break Even)
;    - Usar melhores SL/TP da Fase 1 (fixar)
;    - Ativar Y em:
;      * InpBE_Buy_Enable, InpBE_Buy_Trigger, InpBE_Buy_Step
;      * InpBE_Sell_Enable, InpBE_Sell_Trigger, InpBE_Sell_Step
;    - Objetivo: Proteger lucros sem cortar winners
;    - Tempo esperado: 20-40 minutos
;
; 4. OTIMIZAÇÃO FASE 3 (Scores)
;    - Fixar SL/TP + BE das fases anteriores
;    - Ativar Y em:
;      * InpMinScoreBuy, InpMinScoreSell
;    - Objetivo: Balance entre frequência e qualidade
;    - Tempo esperado: 10-20 minutos
;
; 5. OTIMIZAÇÃO FASE 4 (Drawdown Protection)
;    - Fixar todas fases anteriores
;    - Ativar Y em:
;      * InpDD_Enable, InpDD_DailyMax, InpDD_ConsecLoss, InpDD_LotReduce
;    - Objetivo: Proteger conta em períodos ruins
;    - Tempo esperado: 15-30 minutos
;
; 6. VALIDAÇÃO FINAL
;    - Forward Test: 20-30% dados não usados
;    - Walk-Forward: 3-6 meses in-sample, 1 mês out-of-sample
;    - Monte Carlo: 1000+ simulações
;    - Validar estabilidade em diferentes condições
;
; 7. DEMO ACCOUNT
;    - Rodar configuração final por 2+ semanas
;    - Monitorar performance real vs backtest
;    - Ajustar se necessário
;
; 8. LIVE ACCOUNT
;    - Começar com lote mínimo
;    - Aumentar gradualmente após 1+ mês estável
;    - Monitorar diariamente
;
; ═══════════════════════════════════════════════════════════════════
; CONFIGURAÇÕES POR MERCADO (VALORES INICIAIS SUGERIDOS)
; ═══════════════════════════════════════════════════════════════════
;
; FOREX (EURUSD M15):
;   InpStopLossBuy/Sell = 200-400
;   InpTakeProfitBuy/Sell = 600-1200
;   InpBE_*_Trigger = 150-300
;   InpBE_*_Step = 30-80
;   InpMaxSpread = 15-20
;   InpTradeOnMonday = false
;
; B3 WIN (M5):
;   InpStopLossBuy/Sell = 300-500
;   InpTakeProfitBuy/Sell = 900-1500
;   InpBE_*_Trigger = 200-400
;   InpBE_*_Step = 50-100
;   InpMaxSpread = 8-10
;   InpUseTimeFilter = true (09:15-17:45)
;   InpTradeOnMonday = true
;
; US30 (M15):
;   InpStopLossBuy/Sell = 20-40
;   InpTakeProfitBuy/Sell = 60-120
;   InpBE_*_Trigger = 15-30
;   InpBE_*_Step = 5-15
;   InpMaxSpread = 10-15
;   InpTradeOnMonday = false
;
; XAUUSD (M15):
;   InpStopLossBuy/Sell = 200-400
;   InpTakeProfitBuy/Sell = 600-1200
;   InpBE_*_Trigger = 150-300
;   InpBE_*_Step = 50-100
;   InpMaxSpread = 25-30
;   InpTradeOnMonday = false
;
; ═══════════════════════════════════════════════════════════════════
; TROUBLESHOOTING:
; ═══════════════════════════════════════════════════════════════════
;
; OTIMIZAÇÃO MUITO LENTA:
;   1. Desabilitar InpGG_CreateObjects (já configurado como false)
;   2. Reduzir InpLogLevel para 1
;   3. Otimizar em fases (não tudo junto)
;   4. Usar Complete Algorithm (mais rápido que Genetic)
;
; POUCOS TRADES NO BACKTEST:
;   1. Verificar perfis (InpBuy*Enable, InpSell*Enable)
;   2. Reduzir InpMinScore* (aceitar GOOD também)
;   3. Verificar filtro semanal (dias permitidos)
;   4. Aumentar InpMaxSpread
;   5. Desabilitar InpUseTimeFilter
;
; DRAWDOWN MUITO ALTO:
;   1. Reduzir InpLotSize
;   2. Ativar InpDD_Enable
;   3. Reduzir InpDD_DailyMax (ex: 3-5%)
;   4. Aumentar SL (proteger mais)
;   5. Aceitar apenas PREMIUM (desabilitar GOOD)
;
; WIN RATE MUITO BAIXO (<40%):
;   1. Aceitar apenas PREMIUM (score 4)
;   2. Aumentar InpMinScore*
;   3. Testar apenas BUY ou apenas SELL
;   4. Verificar período do backtest (evitar range extremo)
;
; ═══════════════════════════════════════════════════════════════════

RSI_OPER_LowLevel=30.0||10.0||1.000000||100.000000||N
; 🔥 AJUSTADO: 10→30 (níveis padrão RSI)
RSI_OPER_ShowLevels=true||false||0||true||N

; === 💥 WAE (Operacional) - Momentum ===
WAE_OPER_FastMA=20||20||10||30||N
WAE_OPER_SlowMA=40||40||30||60||N
WAE_OPER_BBLength=20||20||15||30||N
WAE_OPER_BBMultiplier=2.0||2.0||1.5||3.0||N
WAE_OPER_Sensitivity=150||150||100||200||N


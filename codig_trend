//=====================================================
bullBreak1x1Down = trendDir == 1 and not na(gann1x1) and ta.crossunder(close, gann1x1)
bullReclaim1x1   = trendDir == 1 and not na(gann1x1) and ta.crossover(close, gann1x1)

bearBreak1x1Up   = trendDir == -1 and not na(gann1x1) and ta.crossover(close, gann1x1)
bearReject1x1    = trendDir == -1 and not na(gann1x1) and ta.crossunder(close, gann1x1)

currentBreakDistance = not na(gann1x1) ? math.abs(close - gann1x1) : 0.0
currentBreakStrong   = atrVal > 0 and currentBreakDistance >= atrVal * signalAtrMult

bullHeatTouch = inHeatZone and not na(heatBotNow) and low <= heatBotNow
bearHeatTouch = inHeatZone and not na(heatTopNow) and high >= heatTopNow

heatBullReaction =
     trendDir == 1 and
     bullHeatTouch and
     close > open

heatBearReaction =
     trendDir == -1 and
     bearHeatTouch and
     close < open

heatReactionText = heatBullReaction ? "Bull Confirmed" : heatBearReaction ? "Bear Confirmed" : "None"

cooldownPassed = na(lastSignalBar) or bar_index - lastSignalBar > signalCooldown
isInsideCurrentDrawing = haveAnchors and bar_index >= anchorBar1 and bar_index <= boxRightX

aggressiveBuy =
     trendDir == 1 and
     inHeatZone and
     heatBullReaction and
     not na(gann1x1) and
     close > gann1x1 and
     cooldownPassed

aggressiveSell =
     trendDir == -1 and
     inHeatZone and
     heatBearReaction and
     not na(gann1x1) and
     close < gann1x1 and
     cooldownPassed

reversalWatch =
     currentBreakStrong and
     ((trendDir == 1 and bullBreak1x1Down) or (trendDir == -1 and bearBreak1x1Up)) and
     cooldownPassed

trendContinuation =
     ((trendDir == 1 and bullReclaim1x1) or (trendDir == -1 and bearReject1x1)) and
     cooldownPassed

if barstate.isconfirmed and isInsideCurrentDrawing and not structureChanged
    if heatBullReaction
        bullReactionCount += 1
    if heatBearReaction
        bearReactionCount += 1
    if bullBreak1x1Down or bearBreak1x1Up
        breakEventCount += 1
        lastBreakSideText     := bullBreak1x1Down ? "Down" : "Up"
        lastBreakStrengthText := currentBreakStrong ? "STRONG" : "NORMAL"
        lastBreakBar          := bar_index

if barstate.isconfirmed and showBreakLb and isInsideCurrentDrawing and not structureChanged
    sigX = bar_index + signalLabelOffset

    if bullBreak1x1Down
        if not na(lbBreakDown)
            label.delete(lbBreakDown)
        if not na(lnBreakDown)
            line.delete(lnBreakDown)
        lbBreakDown := label.new(sigX, low, "1x1 Break Down", xloc = xloc.bar_index, style = label.style_label_down, color = color.new(colBear, 0), textcolor = color.white, size = labelSize)
        lnBreakDown := line.new(bar_index, low, sigX, low, xloc = xloc.bar_index, color = color.new(colBear, 0), width = 1)
        srcBreakDown := bar_index

    if bullReclaim1x1
        if not na(lbReclaim)
            label.delete(lbReclaim)
        if not na(lnReclaim)
            line.delete(lnReclaim)
        lbReclaim := label.new(sigX, high, "1x1 Reclaim", xloc = xloc.bar_index, style = label.style_label_up, color = color.new(colBull, 0), textcolor = color.white, size = labelSize)
        lnReclaim := line.new(bar_index, high, sigX, high, xloc = xloc.bar_index, color = color.new(colBull, 0), width = 1)
        srcReclaim := bar_index

    if bearBreak1x1Up
        if not na(lbBreakUp)
            label.delete(lbBreakUp)
        if not na(lnBreakUp)
            line.delete(lnBreakUp)
        lbBreakUp := label.new(sigX, high, "1x1 Break Up", xloc = xloc.bar_index, style = label.style_label_up, color = color.new(colBull, 0), textcolor = color.white, size = labelSize)
        lnBreakUp := line.new(bar_index, high, sigX, high, xloc = xloc.bar_index, color = color.new(colBull, 0), width = 1)
        srcBreakUp := bar_index

    if bearReject1x1
        if not na(lbReject)
            label.delete(lbReject)
        if not na(lnReject)
            line.delete(lnReject)
        lbReject := label.new(sigX, low, "1x1 Reject", xloc = xloc.bar_index, style = label.style_label_down, color = color.new(colBear, 0), textcolor = color.white, size = labelSize)
        lnReject := line.new(bar_index, low, sigX, low, xloc = xloc.bar_index, color = color.new(colBear, 0), width = 1)
        srcReject := bar_index

if barstate.isconfirmed and showSignals and isInsideCurrentDrawing and not structureChanged
    sigX = bar_index + signalLabelOffset

    if aggressiveBuy
        if not na(lbAggBuy)
            label.delete(lbAggBuy)
        if not na(lnAggBuy)
            line.delete(lnAggBuy)
        lbAggBuy := label.new(sigX, low, "Aggressive Buy", xloc = xloc.bar_index, style = label.style_label_up, color = color.new(colBull, 0), textcolor = color.white, size = labelSize)
        lnAggBuy := line.new(bar_index, low, sigX, low, xloc = xloc.bar_index, color = color.new(colBull, 0), width = 1)
        srcAggBuy := bar_index
        lastSignalBar := bar_index

    if aggressiveSell
        if not na(lbAggSell)
            label.delete(lbAggSell)
        if not na(lnAggSell)
            line.delete(lnAggSell)
        lbAggSell := label.new(sigX, high, "Aggressive Sell", xloc = xloc.bar_index, style = label.style_label_down, color = color.new(colBear, 0), textcolor = color.white, size = labelSize)
        lnAggSell := line.new(bar_index, high, sigX, high, xloc = xloc.bar_index, color = color.new(colBear, 0), width = 1)
        srcAggSell := bar_index
        lastSignalBar := bar_index

    if reversalWatch
        if not na(lbRevWatch)
            label.delete(lbRevWatch)
        if not na(lnRevWatch)
            line.delete(lnRevWatch)
        lbRevWatch := label.new(sigX, close, "Reversal Watch", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(colNeutral, 0), textcolor = color.white, size = labelSize)
        lnRevWatch := line.new(bar_index, close, sigX, close, xloc = xloc.bar_index, color = color.new(colNeutral, 0), width = 1)
        srcRevWatch := bar_index
        lastSignalBar := bar_index

    if trendContinuation
        if not na(lbTrendCont)
            label.delete(lbTrendCont)
        if not na(lnTrendCont)
            line.delete(lnTrendCont)
        lbTrendCont := label.new(sigX, close, "Trend Cont.", xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.blue, 25), textcolor = color.white, size = labelSize)
        lnTrendCont := line.new(bar_index, close, sigX, close, xloc = xloc.bar_index, color = color.new(color.blue, 25), width = 1)
        srcTrendCont := bar_index
        lastSignalBar := bar_index

if barstate.islast and haveAnchors
    xMin = anchorBar1
    xMax = boxRightX

    if not na(lbBreakDown) and (na(srcBreakDown) or srcBreakDown < xMin or srcBreakDown > xMax)
        label.delete(lbBreakDown)
        lbBreakDown := na
        srcBreakDown := na
        if not na(lnBreakDown)
            line.delete(lnBreakDown)
            lnBreakDown := na

    if not na(lbReclaim) and (na(srcReclaim) or srcReclaim < xMin or srcReclaim > xMax)
        label.delete(lbReclaim)
        lbReclaim := na
        srcReclaim := na
        if not na(lnReclaim)
            line.delete(lnReclaim)
            lnReclaim := na

    if not na(lbBreakUp) and (na(srcBreakUp) or srcBreakUp < xMin or srcBreakUp > xMax)
        label.delete(lbBreakUp)
        lbBreakUp := na
        srcBreakUp := na
        if not na(lnBreakUp)
            line.delete(lnBreakUp)
            lnBreakUp := na

    if not na(lbReject) and (na(srcReject) or srcReject < xMin or srcReject > xMax)
        label.delete(lbReject)
        lbReject := na
        srcReject := na
        if not na(lnReject)
            line.delete(lnReject)
            lnReject := na

    if not na(lbAggBuy) and (na(srcAggBuy) or srcAggBuy < xMin or srcAggBuy > xMax)
        label.delete(lbAggBuy)
        lbAggBuy := na
        srcAggBuy := na
        if not na(lnAggBuy)
            line.delete(lnAggBuy)
            lnAggBuy := na

    if not na(lbAggSell) and (na(srcAggSell) or srcAggSell < xMin or srcAggSell > xMax)
        label.delete(lbAggSell)
        lbAggSell := na
        srcAggSell := na
        if not na(lnAggSell)
            line.delete(lnAggSell)
            lnAggSell := na

    if not na(lbRevWatch) and (na(srcRevWatch) or srcRevWatch < xMin or srcRevWatch > xMax)
        label.delete(lbRevWatch)
        lbRevWatch := na
        srcRevWatch := na
        if not na(lnRevWatch)
            line.delete(lnRevWatch)
            lnRevWatch := na

    if not na(lbTrendCont) and (na(srcTrendCont) or srcTrendCont < xMin or srcTrendCont > xMax)
        label.delete(lbTrendCont)
        lbTrendCont := na
        srcTrendCont := na
        if not na(lnTrendCont)
            line.delete(lnTrendCont)
            lnTrendCont := na
//=====================================================
// SCORE
//=====================================================
float score = 0.0

if trendDir == 1 and not na(gann1x1) and close > gann1x1
    score += 3
if trendDir == -1 and not na(gann1x1) and close < gann1x1
    score -= 3

if inHeatZone
    score += trendDir == 1 ? 1 : trendDir == -1 ? -1 : 0

sq9Up1 = haveAnchors ? f_sq9_price(anchorPrice2, sq9StepFinal, 1, true) : na
sq9Dn1 = haveAnchors ? f_sq9_price(anchorPrice2, sq9StepFinal, 1, false) : na

if not na(sq9Up1) and close > sq9Up1
    score += 1
if not na(sq9Dn1) and close < sq9Dn1
    score -= 1

if heatBullReaction
    score += 1
if heatBearReaction
    score -= 1

scoreClamped = f_clamp(score, -8, 8)

trendText = "NEUTRAL"

if scoreClamped >= 4
    trendText := "STRONG BULL"
else if scoreClamped >= 1
    trendText := "BULL BIAS"
else if scoreClamped <= -4
    trendText := "STRONG BEAR"
else if scoreClamped <= -1
    trendText := "BEAR BIAS"

//=====================================================
// PANEL
//=====================================================
if barstate.islast and not showScorePanel
    table.clear(scoreTable, 0, 0, 1, 15)

if barstate.islast and showScorePanel
    panel1x1State = "na"
    if not na(gann1x1)
        panel1x1State := math.abs(close - gann1x1) <= syminfo.mintick ? "At 1x1" : close > gann1x1 ? "Above" : "Below"

    panel1x1Price = not na(gann1x1) ? str.tostring(gann1x1, format.mintick) : "na"

    panelMode          = (trendDir == 1 ? "Bullish" : trendDir == -1 ? "Bearish" : "Neutral") + " / " + (gannEngineMode == "Classic Gann" ? "Classic Gann" : "Gann Style")
    panelPocLevelText  = gannEngineMode == "Gann Style" ? panelPocLevel : "na"
    panelPocPriceText  = gannEngineMode == "Gann Style" and not na(panelPocPrice) ? str.tostring(panelPocPrice, format.mintick) : "na"
    panelLastBreakText = na(lastBreakBar) ? "na" : lastBreakSideText + " / " + lastBreakStrengthText
    panelRejectText = bearReject1x1 ? "Active" : "None"

    panelHdrBg      = f_panel_bg_base()
    panelTrendBg    = f_panel_bg_trend(trendDir)
    panelTrendBgHi  = f_panel_bg_trend_strong(trendDir)

    panelHdrTxt     = color.new(color.blue, 0)
    panelTrendTxt   = f_panel_text_trend(trendDir)
    panelTrendTxt2  = f_panel_text_trend_soft(trendDir)

    biasText      = scoreClamped > 0 ? "Bullish" : scoreClamped < 0 ? "Bearish" : "Neutral"
    biasTextColor = scoreClamped > 0 ? color.new(colBull, 0) : scoreClamped < 0 ? color.new(colBear, 0) : color.new(colNeutral, 0)

    panelTrendBgRow  = trendDir == 1 ? color.new(colBull, 72) : trendDir == -1 ? color.new(colBear, 72) : color.new(colNeutral, 72)
    panelTrendTxtRow = trendDir == 1 ? color.new(colBull, 0)  : trendDir == -1 ? color.new(colBear, 0)  : color.new(colNeutral, 0)

    panelFocusBg      = color.new(color.yellow, 78)
    panelFocusBgHi    = color.new(color.yellow, 70)
    panelFocusTxt     = color.new(color.yellow, 0)
    panelFocusTxtSoft = color.new(color.orange, 0)

    table.cell(scoreTable, 0, 0, "Metric", text_color = panelHdrTxt, bgcolor = panelHdrBg)
    table.cell(scoreTable, 1, 0, "State",  text_color = panelHdrTxt, bgcolor = panelHdrBg)

    table.cell(scoreTable, 0, 1, "Mode", text_color = panelTrendTxt2, bgcolor = panelTrendBg)
    table.cell(scoreTable, 1, 1, panelMode, text_color = panelTrendTxt, bgcolor = panelTrendBg)

    table.cell(scoreTable, 0, 2, "Trend", text_color = panelTrendTxtRow, bgcolor = panelTrendBgRow)
    table.cell(scoreTable, 1, 2, trendText, text_color = panelTrendTxtRow, bgcolor = panelTrendBgRow)

    table.cell(scoreTable, 0, 3, "Score", text_color = panelTrendTxt2, bgcolor = panelTrendBg)
    table.cell(scoreTable, 1, 3, str.tostring(scoreClamped), text_color = panelTrendTxt, bgcolor = panelTrendBg)

    table.cell(scoreTable, 0, 4, "1x1 Now", text_color = panelFocusTxtSoft, bgcolor = panelFocusBg)
    table.cell(scoreTable, 1, 4, panel1x1Price, text_color = panelFocusTxt, bgcolor = panelFocusBgHi)

    table.cell(scoreTable, 0, 5, "POC Level", text_color = panelFocusTxtSoft, bgcolor = panelFocusBg)
    table.cell(scoreTable, 1, 5, panelPocLevelText, text_color = panelFocusTxt, bgcolor = panelFocusBgHi)

    table.cell(scoreTable, 0, 6, "POC Price", text_color = panelFocusTxtSoft, bgcolor = panelFocusBg)
    table.cell(scoreTable, 1, 6, panelPocPriceText, text_color = panelFocusTxt, bgcolor = panelFocusBgHi)

    table.cell(scoreTable, 0, 7, "Price / 1x1", text_color = panelTrendTxt2, bgcolor = panelTrendBg)
    table.cell(scoreTable, 1, 7, panel1x1State, text_color = panelTrendTxt, bgcolor = panelTrendBg)

    table.cell(scoreTable, 0, 8, "Heat", text_color = panelTrendTxt2, bgcolor = panelTrendBg)
    table.cell(scoreTable, 1, 8, inHeatZone ? "Inside" : "Outside", text_color = panelTrendTxt, bgcolor = panelTrendBg)

    table.cell(scoreTable, 0, 9, "Reaction", text_color = panelTrendTxt2, bgcolor = panelTrendBg)
    table.cell(scoreTable, 1, 9, heatReactionText, text_color = panelTrendTxt, bgcolor = panelTrendBg)

    table.cell(scoreTable, 0, 10, "Last Break", text_color = panelTrendTxt2, bgcolor = panelTrendBg)
    table.cell(scoreTable, 1, 10, panelLastBreakText, text_color = panelTrendTxt, bgcolor = panelTrendBg)

    table.cell(scoreTable, 0, 11, "Bull Count", text_color = color.new(colBull, 0), bgcolor = panelTrendBgHi)
    table.cell(scoreTable, 1, 11, str.tostring(bullReactionCount), text_color = color.new(colBull, 0), bgcolor = panelTrendBgHi)

    table.cell(scoreTable, 0, 12, "Bear Count", text_color = color.new(colBear, 0), bgcolor = panelTrendBgHi)
    table.cell(scoreTable, 1, 12, str.tostring(bearReactionCount), text_color = color.new(colBear, 0), bgcolor = panelTrendBgHi)

    table.cell(scoreTable, 0, 13, "Break Count", text_color = color.new(colNeutral, 0), bgcolor = panelTrendBgHi)
    table.cell(scoreTable, 1, 13, str.tostring(breakEventCount), text_color = color.new(colNeutral, 0), bgcolor = panelTrendBgHi)

    table.cell(scoreTable, 0, 14, "Reject", text_color = color.new(colBear, 0), bgcolor = panelTrendBgHi)
    table.cell(scoreTable, 1, 14, panelRejectText, text_color = color.new(colBear, 0), bgcolor = panelTrendBgHi)

    table.cell(scoreTable, 0, 15, "Bias", text_color = biasTextColor, bgcolor = panelTrendBgHi)
    table.cell(scoreTable, 1, 15, biasText, text_color = biasTextColor, bgcolor = panelTrendBgHi)

//=====================================================
// ALERTS
//=====================================================
alertcondition(bullBreak1x1Down, "Bull 1x1 Break Down", "Bull trend 1x1 Gann line broken downward.")
alertcondition(bullReclaim1x1, "Bull 1x1 Reclaim", "Bull trend reclaimed 1x1 Gann line.")
alertcondition(bearBreak1x1Up, "Bear 1x1 Break Up", "Bear trend 1x1 Gann line broken upward.")
alertcondition(bearReject1x1, "Bear 1x1 Reject", "Bear trend rejected from 1x1 Gann line.")
alertcondition(scoreClamped >= 4, "Strong Bull Score", "Gann Pressure Matrix PRO v8 strong bull score active.")
alertcondition(scoreClamped <= -4, "Strong Bear Score", "Gann Pressure Matrix PRO v8 strong bear score active.")
alertcondition(aggressiveBuy, "Aggressive Buy", "Gann Pressure Matrix PRO v8 aggressive buy signal.")
alertcondition(aggressiveSell, "Aggressive Sell", "Gann Pressure Matrix PRO v8 aggressive sell signal.")
alertcondition(reversalWatch, "Reversal Watch", "Gann Pressure Matrix PRO v8 reversal watch signal.")
alertcondition(trendContinuation, "Trend Continuation", "Gann Pressure Matrix PRO v8 trend continuation signal.")
//=====================================================
// FINISH

                        float barRange = math.max(bHigh - bLow, syminfo.mintick)
                        float zoneVol  = bVol * (overlap / barRange)

                        float buyShare  = f_clamp((bClose - bLow) / barRange, 0.0, 1.0)
                        float sellShare = f_clamp((bHigh - bClose) / barRange, 0.0, 1.0)


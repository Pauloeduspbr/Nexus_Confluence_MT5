; 💰 RISCO ADAPTATIVO - DESABILITADO (Conservador)
; ═══════════════════════════════════════════════════════════════
UseAdaptiveSizing=false||false|||N
WinStreakMultiplier=1.2||1.2||1.0||3.0||N
WinStreakThreshold=2||2||1||10||N
LossStreakDivisor=0.5||0.5||0.1||1.0||N
LossStreakThreshold=2||2||1||10||N
MaxPositionMultiplier=2.0||2.0||1.0||5.0||N
MaxDailyLoss=5.0||5.0||1.0||20.0||N
MaxWeeklyLoss=10.0||10.0||2.0||50.0||N
ReduceRiskAfterLoss=true||true|||N
RiskReductionFactor=0.5||0.5||0.1||1.0||N
RecoveryMode=false||false|||N


InpST_ATR_Multiplier=1.0||1.0||0.5||3.0||N

; ═══════════ 💥 MOMENTUM (OBV MACD) (FIXO) ═══════════
InpMACD_FastEMA=12||12||5||40||N
InpMACD_SlowEMA=26||26||10||80||N

; Nexus Confluence EA v4.16 - Configuração Otimizada Baseline
; Data: 20/10/2025
; Objetivo: Corrigir PF 1.10/DD 55% para PF 1.5+/DD <20%
; Perfil: Conservador com TP's estendidos + Todos parametros ajustaveis

; ═══════════════════════════════════════════════════════════════
; 💰 GESTÃO DE RISCO - CONSERVADOR
; ═══════════════════════════════════════════════════════════════
AccountRiskPercent=0.5||0.5||0.1||5.0||N
MaxRiskPremium=1.0||1.0||0.1||5.0||N
MaxDailyDrawdown=3.0||3.0||0.5||10.0||N
MaxWeeklyDrawdown=5.0||5.0||1.0||20.0||N
MaxConsecutiveLosses=3||3||1||10||N
MaxSimultaneousTrades=3||3||1||10||N
FixedLotSize=0.0||0.0||0.0||10.0||N

; ═══════════════════════════════════════════════════════════════
; 🛡️ STOP LOSS ESTRUTURAL - PARAMETRIZADO
; ═══════════════════════════════════════════════════════════════
SL_UseStructure=true||true|||N
SL_StructureCandles=50||50||20||100||N
SL_StructureStrength=2.0||2.0||1.0||5.0||N
SL_SafetyMultiplier=1.2||1.2||1.0||2.0||N
SL_BufferPoints=10.0||10.0||0.0||50.0||N
SL_FallbackPercent=0.3||0.3||0.1||1.0||N
SL_MinDistancePoints=50.0||50.0||10.0||200.0||N
SL_MaxDistancePoints=500.0||500.0||100.0||2000.0||N

; ═══════════════════════════════════════════════════════════════
; 🎯 TAKE PROFIT DINÂMICO - BASEADO EM ATR
; ═══════════════════════════════════════════════════════════════
EnablePartialTP=true||true|||N
TP_UseATR=true||true|||N
TP1_RR=1.5||1.5||0.5||5.0||N
TP2_RR=3.0||3.0||1.0||10.0||N
TP3_RR=5.0||5.0||2.0||20.0||N
UseTP3=false||false|||N
TP1_ATRMultiplier=2.0||2.0||0.5||10.0||N
TP2_ATRMultiplier=4.0||4.0||1.0||20.0||N
TP3_ATRMultiplier=6.0||6.0||2.0||30.0||N
TP_MinRRRatio=1.2||1.2||0.5||3.0||N
TP1_ClosePercent=40.0||40.0||10.0||100.0||N
TP2_ClosePercent=40.0||40.0||10.0||100.0||N
TP3_ClosePercent=20.0||20.0||10.0||100.0||N

; ═══════════════════════════════════════════════════════════════
; 📈 TRAILING STOP AVANÇADO
; ═══════════════════════════════════════════════════════════════
EnableTrailing=true||true|||N
TrailingUseATR=true||true|||N
TrailingATRMultiplier=2.5||2.5||1.0||10.0||N
TrailingDistancePoints=200.0||200.0||50.0||1000.0||N
TrailingStepPoints=50.0||50.0||10.0||200.0||N
TrailingActivationRR=1.5||1.5||0.5||5.0||N
TrailingStartAfterTP=true||true|||N
TrailingMinProfit=0.5||0.5||0.1||5.0||N
TrailingMaxRisk=0.2||0.2||0.0||1.0||N

; ═══════════════════════════════════════════════════════════════
; 🛡️ BREAKEVEN E PROTEÇÃO DE LUCRO
; ═══════════════════════════════════════════════════════════════
EnableBreakeven=true||true|||N
BreakevenAfterRR=1.0||1.0||0.5||3.0||N
BreakevenPlusPoints=5.0||5.0||0.0||50.0||N
EnableProfitLock=true||true|||N
LockProfitAfterRR=2.0||2.0||1.0||5.0||N
LockProfitPercent=50.0||50.0||10.0||100.0||N


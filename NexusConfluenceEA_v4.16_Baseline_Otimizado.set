CustomEndHour=16||16||0||23||N
CustomEndMinute=0||0||0||59||N
TradeOnMonday=true||true|||N
TradeOnTuesday=true||true|||N
TradeOnWednesday=true||true|||N
TradeOnThursday=true||true|||N
TradeOnFriday=true||true|||N
TradeOnSaturday=false||false|||N
TradeOnSunday=false||false|||N


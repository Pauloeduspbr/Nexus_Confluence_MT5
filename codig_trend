//=====================================================
// HELPERS
//=====================================================
f_line_style(_s) =>
    _s == "Solid" ? line.style_solid : _s == "Dashed" ? line.style_dashed : line.style_dotted

f_txt_size(_s, _compact) =>
    _compact ? size.tiny :
     _s == "auto"   ? size.auto   :
     _s == "tiny"   ? size.tiny   :
     _s == "small"  ? size.small  :
     _s == "normal" ? size.normal :
     _s == "large"  ? size.large  :
     _s == "huge"   ? size.huge   : size.normal

f_classic_x2(_startX, _originLeft, _frameRangeY, _frameRunBars, _baseSlope, _mult) =>
    slopePerBar = math.max(_baseSlope * _mult, syminfo.mintick)
    barsToEdge  = int(math.floor(_frameRangeY / slopePerBar))
    runBars     = math.max(1, math.min(_frameRunBars, barsToEdge))
    _originLeft ? _startX + runBars : _startX - runBars

f_classic_y2(_startYFan, _ySign, _baseSlope, _mult, _x2, _startX) =>
    runBarsSigned = math.abs(_x2 - _startX)
    _startYFan + _ySign * _baseSlope * _mult * runBarsSigned

f_clear_lines(line[] arr) =>
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            line.delete(array.get(arr, i))
        array.clear(arr)

f_clear_labels(label[] arr) =>
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            label.delete(array.get(arr, i))
        array.clear(arr)

f_clear_boxes(box[] arr) =>
    sz = array.size(arr)
    if sz > 0
        for i = 0 to sz - 1
            box.delete(array.get(arr, i))
        array.clear(arr)

f_sq9_price(float basePrice, float stepFrac, int n, bool up) =>
    root = math.sqrt(math.max(basePrice, syminfo.mintick))
    lvlRoot = up ? root + stepFrac * n : root - stepFrac * n
    math.pow(math.max(lvlRoot, 0.0), 2)

f_line_y(line ln, int x) =>
    not na(ln) ? line.get_price(ln, x) : na

f_clamp(float v, float lo, float hi) =>
    math.max(lo, math.min(v, hi))

f_is_left_origin(string origin) =>
    origin == "Top Left" or origin == "Bottom Left"

f_is_top_origin(string origin) =>
    origin == "Top Left" or origin == "Top Right"

f_target_y(string origin, float topY, float botY, float frac) =>
    rng = math.max(topY - botY, syminfo.mintick)
    f_is_top_origin(origin) ? topY - rng * frac : botY + rng * frac

f_target_x(string origin, int leftX, int rightX, float frac) =>
    span = math.max(rightX - leftX, 1)
    f_is_left_origin(origin) ? leftX + int(math.round(span * frac)) : rightX - int(math.round(span * frac))

f_fan_line_color(_mode, _trendColor, _levelColor, _alpha) =>
    _mode == "Per Level" ? color.new(_levelColor, _alpha) : color.new(_trendColor, _alpha)

f_fan_label_color(_mode, _trendColor, _levelColor, _isMain) =>
    _mode == "Per Level" ? _levelColor : _isMain ? color.white : color.new(_trendColor, 5)

f_panel_bg_base() =>
    color.new(color.blue, 75)

f_panel_bg_soft() =>
    color.new(color.black, 18)

f_panel_bg_trend(int _dir) =>
    _dir == 1 ? color.new(colBull, 82) : _dir == -1 ? color.new(colBear, 82) : color.new(colNeutral, 82)

f_panel_bg_trend_strong(int _dir) =>
    _dir == 1 ? color.new(colBull, 68) : _dir == -1 ? color.new(colBear, 68) : color.new(colNeutral, 68)

f_panel_text_trend(int _dir) =>
    _dir == 1 ? color.new(colBull, 0) : _dir == -1 ? color.new(colBear, 0) : color.new(colNeutral, 0)

f_panel_text_trend_soft(int _dir) =>
    _dir == 1 ? color.new(colBull, 12) : _dir == -1 ? color.new(colBear, 12) : color.new(colNeutral, 12)

f_interp_y(_x1, _y1, _x2, _y2, _x) =>
    dx = _x2 - _x1
    dx == 0 ? _y1 : _y1 + (_y2 - _y1) * ((_x - _x1) / dx)

float sq9StepFinal = sq9StepFrac
//=====================================================
// PIVOTS + ACTIVE CONFIRMED PIVOT / LIVE EXTREMUM ENGINE
//=====================================================
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

var float lastHighPrice = na
var int   lastHighBar   = na
var float lastLowPrice  = na
var int   lastLowBar    = na

if not na(ph)
    lastHighPrice := ph
    lastHighBar   := bar_index - rightBars

if not na(pl)
    lastLowPrice := pl
    lastLowBar   := bar_index - rightBars

haveHigh = not na(lastHighPrice) and not na(lastHighBar)
haveLow  = not na(lastLowPrice) and not na(lastLowBar)

float anchorPrice1 = na
float anchorPrice2 = na
int   anchorBar1   = na
int   anchorBar2   = na
int   trendDir     = 0

float bullAnchorPrice1 = na
float bullAnchorPrice2 = na
int   bullAnchorBar1   = na
int   bullAnchorBar2   = na

float bearAnchorPrice1 = na
float bearAnchorPrice2 = na
int   bearAnchorBar1   = na
int   bearAnchorBar2   = na

if haveLow
    bullAnchorPrice1 := lastLowPrice
    bullAnchorBar1   := lastLowBar

    bullSpan = math.max(0, math.min(bar_index - bullAnchorBar1, 500))

    float liveHigh = na
    int   liveHighBar = na

    for j = 0 to bullSpan
        i = bullSpan - j
        v = high[i]
        b = bar_index - i

        if na(liveHigh) or v > liveHigh
            liveHigh    := v
            liveHighBar := b

    bullAnchorPrice2 := liveHigh
    bullAnchorBar2   := liveHighBar

if haveHigh
    bearAnchorPrice1 := lastHighPrice
    bearAnchorBar1   := lastHighBar

    bearSpan = math.max(0, math.min(bar_index - bearAnchorBar1, 500))

    float liveLow = na
    int   liveLowBar = na

    for j = 0 to bearSpan
        i = bearSpan - j
        v = low[i]
        b = bar_index - i

        if na(liveLow) or v < liveLow
            liveLow    := v
            liveLowBar := b

    bearAnchorPrice2 := liveLow
    bearAnchorBar2   := liveLowBar

bullValid =
     not na(bullAnchorPrice1) and
     not na(bullAnchorPrice2) and
     not na(bullAnchorBar1) and
     not na(bullAnchorBar2) and
     bullAnchorBar2 >= bullAnchorBar1

bearValid =
     not na(bearAnchorPrice1) and
     not na(bearAnchorPrice2) and
     not na(bearAnchorBar1) and
     not na(bearAnchorBar2) and
     bearAnchorBar2 >= bearAnchorBar1

if bullValid and bearValid
    if bullAnchorBar2 > bearAnchorBar2
        trendDir     := 1
        anchorPrice1 := bullAnchorPrice1
        anchorPrice2 := bullAnchorPrice2
        anchorBar1   := bullAnchorBar1
        anchorBar2   := bullAnchorBar2
    else if bearAnchorBar2 > bullAnchorBar2
        trendDir     := -1
        anchorPrice1 := bearAnchorPrice1
        anchorPrice2 := bearAnchorPrice2
        anchorBar1   := bearAnchorBar1
        anchorBar2   := bearAnchorBar2
    else
        if bullAnchorBar1 >= bearAnchorBar1
            trendDir     := 1
            anchorPrice1 := bullAnchorPrice1
            anchorPrice2 := bullAnchorPrice2
            anchorBar1   := bullAnchorBar1
            anchorBar2   := bullAnchorBar2
        else
            trendDir     := -1
            anchorPrice1 := bearAnchorPrice1
            anchorPrice2 := bearAnchorPrice2
            anchorBar1   := bearAnchorBar1
            anchorBar2   := bearAnchorBar2
else if bullValid
    trendDir     := 1
    anchorPrice1 := bullAnchorPrice1
    anchorPrice2 := bullAnchorPrice2
    anchorBar1   := bullAnchorBar1
    anchorBar2   := bullAnchorBar2
else if bearValid
    trendDir     := -1
    anchorPrice1 := bearAnchorPrice1
    anchorPrice2 := bearAnchorPrice2
    anchorBar1   := bearAnchorBar1
    anchorBar2   := bearAnchorBar2

haveAnchors =
     not na(anchorPrice1) and
     not na(anchorPrice2) and
     not na(anchorBar1) and
     not na(anchorBar2) and
     anchorBar2 >= anchorBar1 and
     trendDir != 0

if haveAnchors and sq9AutoPivotScale
    float priceSpanFromAnchor = math.max(math.abs(anchorPrice2 - anchorPrice1), syminfo.mintick)
    float targetPriceStep     = priceSpanFromAnchor / math.max(sq9StepCount * 3.0, 1.0)
    float baseRoot            = math.sqrt(math.max(anchorPrice2, syminfo.mintick))
    float nextRoot            = math.sqrt(math.max(anchorPrice2 + targetPriceStep, syminfo.mintick))
    sq9StepFinal := math.max(nextRoot - baseRoot, 0.000001)
else
    sq9StepFinal := sq9StepFrac

fanColor = trendDir == 1 ? colBull : colBear
atrVal   = ta.atr(14)


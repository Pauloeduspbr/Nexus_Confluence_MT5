UseADXFilter=false||false|||N
ADX_Period=14||14||5||50||N
ADX_MinTrend=25.0||25.0||10.0||50.0||N
AvoidNews=true||true|||N
MaxSpreadMultiplier=5.0||5.0||1.0||100.0||N
EnableSecondaryHours=true||true|||N
EnableMorningB3=false||false|||N


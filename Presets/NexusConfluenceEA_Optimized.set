; ═══════════════════════════════════════════════════════════════════
; NEXUS CONFLUENCE EA v2.00 - ARQUIVO .SET OTIMIZADO
; ═══════════════════════════════════════════════════════════════════
; Criado: 2025.11.02
; Versão: 2.00 (Optimized for Strategy Tester)
; Uso: Strategy Tester → Inputs → Load
;
; LEGENDA:
; Formato: PADRÃO||INÍCIO||PASSO||FIM||Y_ou_N
; Y = Otimizar (varia nos testes)
; N = Fixo (não varia)
;
; FASES DE OTIMIZAÇÃO RECOMENDADAS:
; Fase 1: SL/TP (ativar apenas InpStopLoss* e InpTakeProfit*)
; Fase 2: Break Even (ativar InpBE_*)
; Fase 3: Scores (ativar InpMinScore*)
; Fase 4: Drawdown (ativar InpDD_*)
; ═══════════════════════════════════════════════════════════════════

; ═══════════ 💰 GESTÃO DE RISCO (FASE 1 - CRÍTICO) ═══════════
InpLotSize=0.01||0.01||0.01||0.10||Y
InpMaxSlippage=10||10||5||20||N

; ═══════════ 📈 PARÂMETROS BUY (FASE 1) ═══════════
InpStopLossBuy=300||100||50||600||Y
InpTakeProfitBuy=900||300||100||1800||Y

; ═══════════ 📉 PARÂMETROS SELL (FASE 1) ═══════════
InpStopLossSell=300||100||50||600||Y
InpTakeProfitSell=900||300||100||1800||Y

; ═══════════ 🎯 BREAK EVEN BUY (FASE 2) ═══════════
InpBE_Buy_Enable=true||false||0||true||Y
InpBE_Buy_Trigger=200||50||50||500||Y
InpBE_Buy_Step=50||10||10||100||Y

; ═══════════ 🎯 BREAK EVEN SELL (FASE 2) ═══════════
InpBE_Sell_Enable=true||false||0||true||Y
InpBE_Sell_Trigger=200||50||50||500||Y
InpBE_Sell_Step=50||10||10||100||Y

; ═══════════ 🚀 TRAILING STOP BUY (FASE 5 - OPCIONAL) ═══════════
; RECOMENDAÇÃO: Testar APÓS otimizar SL/TP e Break Even
InpTS_Buy_Enable=false||false||0||true||N
InpTS_Buy_Trigger=400||200||50||800||N
InpTS_Buy_Step=200||50||10||300||N

; ═══════════ 🚀 TRAILING STOP SELL (FASE 5 - OPCIONAL) ═══════════
InpTS_Sell_Enable=false||false||0||true||N
InpTS_Sell_Trigger=400||200||50||800||N
InpTS_Sell_Step=200||50||10||300||N

; ═══════════ 🔍 FILTROS DE SINAL (FASE 3) ═══════════
InpMinScoreBuy=2||2||1||4||Y
InpMinScoreSell=2||2||1||4||Y

; ═══════════ ↕️ CONTROLE DE DIREÇÃO (FIXO - AJUSTAR MANUALMENTE) ═══════════
InpEnableBuy=true||false||0||true||N
InpEnableSell=true||false||0||true||N

; ═══════════ 🛡️ PROTEÇÃO DE DRAWDOWN (FASE 4) ═══════════
InpDD_Enable=true||false||0||true||Y
InpDD_DailyMax=5.0||3||1||10||Y
InpDD_ConsecLoss=5||3||1||8||Y
InpDD_LotReduce=0.5||0.3||0.1||0.9||Y

; ═══════════ 📊 FILTRO DE SPREAD (AJUSTAR POR MERCADO) ═══════════
; Forex: 15-20 | WIN: 10 | Índices: 15 | Metais: 25-30 | Crypto: 40-60
InpMaxSpread=20||10||5||50||Y
InpSpreadMulti=1.5||1.2||0.2||3.0||Y
InpSpreadPeriod=20||20||10||50||N

; ═══════════ 🕐 FILTRO DE HORÁRIO (AJUSTAR POR ATIVO) ═══════════
InpUseTimeFilter=false||false||0||true||N
InpStartTime=09:00
InpEndTime=17:00

; ═══════════ 📅 FILTRO SEMANAL (AJUSTAR POR MERCADO) ═══════════
; Forex/Índices: Skip Monday | B3: Todos os dias | Crypto: 24/7
InpTradeOnSunday=false||false||0||true||N
InpTradeOnMonday=false||false||0||true||N
InpTradeOnTuesday=true||false||0||true||N
InpTradeOnWednesday=true||false||0||true||N
InpTradeOnThursday=true||false||0||true||N
InpTradeOnFriday=true||false||0||true||N
InpTradeOnSaturday=false||false||0||true||N

; ═══════════ ⏰ TIMEFRAMES (FIXO - ESTRUTURAL) ═══════════
; H4 (16388) → H1 (16385) → M30 (30) → M15 (15)
InpMacro1TF=16388||0||0||49153||N
InpMacro2TF=16385||0||0||49153||N
InpMacro3TF=30||0||0||49153||N
InpOperationalTF=15||0||0||49153||N
InpMinScore=2||2||1||4||N

; ═══════════ ⚙️ CONFIGURAÇÕES GERAIS (FIXO) ═══════════
InpMagicNumber=20241024||20241024||1||202410240||N
InpShowPanel=true||false||0||true||N
InpEnableAlerts=false||false||0||true||N
InpEnableEmail=false||false||0||true||N
InpEnablePush=false||false||0||true||N

; ═══════════ 📝 LOGS E DEBUG (FIXO) ═══════════
; 1=Executivo (apenas trades) | 2=Operacional (gates) | 3=Debug (tudo)
InpLogLevel=2||2||1||3||N
InpSaveStats=true||false||0||true||N

; ═══════════ 🧭 PERFIS DE ENTRADA (FIXO - TESTAR MANUALMENTE) ═══════════
; CONSERVADOR: Apenas PREMIUM
; MODERADO: PREMIUM + GOOD
; AGRESSIVO: Todos
InpBuyPremiumEnable=true||false||0||true||N
InpBuyGoodEnable=true||false||0||true||N
InpSellPremiumEnable=true||false||0||true||N
InpSellGoodEnable=true||false||0||true||N

; ═══════════════════════════════════════════════════════════════════
; INDICADORES - NÃO OTIMIZAR (USAR DEFAULTS TESTADOS)
; ═══════════════════════════════════════════════════════════════════

; ═══════════ 📊 GG TREND BAR (FIXO - JÁ OTIMIZADO) ═══════════
InpGG_UpColor=65280
InpGG_DownColor=255
InpGG_FlatColor=65535
InpGG_TextColor=16776960
InpGG_Corner=0||0||0||3||N
InpGG_CreateObjects=false||false||0||true||N
InpGG_ADX_Period=14||14||7||30||N
InpGG_ADX_Price=1||1||0||7||N
InpGG_PSAR_Step=0.02||0.01||0.01||0.05||N
InpGG_PSAR_Max=0.2||0.1||0.1||0.5||N

; ═══════════ 📈 SUPERTREND (TrendMagic) (FIXO) ═══════════
InpST_CCI_Period=50||50||25||100||N

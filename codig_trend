            if i == 0
                yTop := topY
                yBot := math.max(topY - fibHalfH * 2.0, botY)
                yLev := (yTop + yBot) * 0.5
            else if i == array.size(vals) - 1
                yTop := math.min(botY + fibHalfH * 2.0, topY)

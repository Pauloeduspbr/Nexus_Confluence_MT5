            gann1x1 := f_interp_y(startXCore, startYCore, x1x1Core, y1x1Core, bar_index)
            gann2x1 := f_interp_y(startXCore, startYCore, x2x1Core, y2x1Core, bar_index)
        else
            freeRunBarsCore = math.max(math.abs(fanRightX - leftX), 1)
            freeX2Core      = originLeftCore ? fanRightX : leftX

            freeY1x2Core = startYCore + ySignCore * baseSlopeCore * 0.500 * freeRunBarsCore
            freeY1x1Core = startYCore + ySignCore * baseSlopeCore * 1.000 * freeRunBarsCore
            freeY2x1Core = startYCore + ySignCore * baseSlopeCore * 2.000 * freeRunBarsCore

            gann1x2 := f_interp_y(startXCore, startYCore, freeX2Core, freeY1x2Core, bar_index)
            gann1x1 := f_interp_y(startXCore, startYCore, freeX2Core, freeY1x1Core, bar_index)
            gann2x1 := f_interp_y(startXCore, startYCore, freeX2Core, freeY2x1Core, bar_index)

heatTopNowRaw = trendDir == 1 ? gann2x1 : gann1x1
heatBotNowRaw = trendDir == 1 ? gann1x1 : gann1x2

heatTopNow = not na(heatTopNowRaw) and not na(heatBotNowRaw) ? math.max(heatTopNowRaw, heatBotNowRaw) : na
heatBotNow = not na(heatTopNowRaw) and not na(heatBotNowRaw) ? math.min(heatTopNowRaw, heatBotNowRaw) : na

inHeatZone = not na(heatTopNow) and not na(heatBotNow) and close <= heatTopNow and close >= heatBotNow


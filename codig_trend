            x1x1Core = f_classic_x2(startXCore, originLeftCore, frameRangeYCore, frameRunBarsCore, baseSlopeCore, 1.000)
            x2x1Core = f_classic_x2(startXCore, originLeftCore, frameRangeYCore, frameRunBarsCore, baseSlopeCore, 2.000)

            y1x2Core = f_classic_y2(startYCore, ySignCore, baseSlopeCore, 0.500, x1x2Core, startXCore)
            y1x1Core = f_classic_y2(startYCore, ySignCore, baseSlopeCore, 1.000, x1x1Core, startXCore)
            y2x1Core = f_classic_y2(startYCore, ySignCore, baseSlopeCore, 2.000, x2x1Core, startXCore)


; saved on 2025.10.20 (version 4.25)
; this file contains input parameters for testing/optimizing NexusConfluenceEA expert advisor
; to use it in the strategy tester, click Load in the context menu of the Inputs tab
;
; ════════════════════════════════════════════════════════════════════════════════
; 🎯 NEXUS CONFLUENCE v4.25 - CORREÇÕES CRÍTICAS SISTEMA DE BLOQUEIO
; ════════════════════════════════════════════════════════════════════════════════
;
; 🔥 v4.25 CORREÇÕES IMPLEMENTADAS:
; ✅ BUG #1 CORRIGIDO: Drawdown Diário pausava até meia-noite (até 23h59m!)
;    SOLUÇÃO: Agora pausa máximo de 12 horas usando CalculatePauseTime()
;
; ✅ BUG #2 CORRIGIDO: Drawdown Semanal pausava até próxima segunda-feira (até 7 dias!)
;    SOLUÇÃO: Agora pausa máximo de 12 horas usando CalculatePauseTime()
;
; ✅ BUG #3 CORRIGIDO: Perdas Consecutivas pausavam por 24 horas (hardcoded)
;    SOLUÇÃO: Agora pausa máximo de 12 horas usando CalculatePauseTime()
;
; 🛡️ GARANTIAS v4.25:
; - TODOS os bloqueios limitados a MÁXIMO 12 horas
; - Reset automático no início do pregão (CustomStartHour ou 09:00)
; - Force unlock se pausa exceder 12h
; - Tempos de pausa por timeframe: M15=3h, M30=5h, H1=8h, H4/D1=12h
;
; 📊 MANTIDO v4.24:
; - Reset no início do pregão (não meia-noite)
; - Logs visíveis a cada novo candle
;
; 📊 MANTIDO v4.23:
; - Sincronização temporal (GG TrendBar candle [0])
; - M30 divergente = GOOD (não rejeitar)
; - ATR ranges ajustados para pares JPY (5-80 pips)
;
; ════════════════════════════════════════════════════════════════════════════════
; ⚙️ PRESET RECOMENDADO PARA USDJPY (FOREX MAJOR JPY)
; ════════════════════════════════════════════════════════════════════════════════
;
; 🔥 MUDANÇA CRÍTICA RECOMENDADA:
; - AllowGoodSetups=true (ERA false) - PERMITIR setups 2/3 filtros
;   MOTIVO: AllowGoodSetups=false é MUITO RESTRITIVO, exige 3/3 filtros + M30 alinhado
;           Isso pode estar impedindo a abertura de ordens válidas!
;
; 📈 OTIMIZAÇÕES PARA USDJPY:
; - SL_MaxDistancePoints=300 (30 pips) - JPY tem menor volatilidade
; - CustomStartHour=0, CustomEndHour=23 - Operar 24h (testar horários depois)
; - MaxConsecutiveLosses=3 - Pausa máxima 12h após 3 perdas
; - MaxDailyDrawdown=3%, MaxWeeklyDrawdown=5% - Proteção conservadora
;
; ════════════════════════════════════════════════════════════════════════════════

; === ⚙️ CONFIGURAÇÕES GERAIS ===
AccountRiskPercent=0.5||0.5||0.1||5.0||N
MaxRiskPremium=1.0||1.0||0.1||5.0||N
MaxDailyDrawdown=3.0||3.0||0.5||10.0||N
MaxWeeklyDrawdown=5.0||5.0||1.0||20.0||N
MaxConsecutiveLosses=3||3||1||10||N
MaxSimultaneousTrades=3||3||1||10||N
EnableSecondaryHours=true||false||0||true||N
EnableMorningB3=false||false||0||true||N
AvoidNews=true||false||0||true||N
ValidateATRRange=true||false||0||true||N
SendAlerts=true||false||0||true||N
AllowCautiousSetups=false||false||0||true||N
AllowGoodSetups=true||false||0||true||N
; 🔥 MUDANÇA: AllowGoodSetups=false→true (PERMITIR setups GOOD 2/3 filtros)
; IMPORTANTE: false é MUITO restritivo, exige PREMIUM (3/3 + M30 alinhado)

; === 💰 GESTÃO DE LOTE ===
FixedLotSize=0.0||0.0||0.000000||0.000000||N
; 0.0 = Cálculo automático por risco %
; Forex Major: 0.01 mínimo | B3: 1.0 | Índices: 0.1

; === 📅 FILTRO SEMANAL - Dias da Semana ===
TradeOnMonday=true||false||0||true||N
TradeOnTuesday=true||false||0||true||N
TradeOnWednesday=true||false||0||true||N
TradeOnThursday=true||false||0||true||N
TradeOnFriday=true||false||0||true||N
TradeOnSaturday=false||false||0||true||N
TradeOnSunday=false||false||0||true||N

; === ⏰ HORÁRIOS CUSTOMIZÁVEIS (para otimização) ===
UseCustomTradingHours=true||false||0||true||Y
CustomStartHour=0||10||0||23||N
; 🔥 v4.25: CustomStartHour também define horário de RESET dos contadores!
; Sugestão inicial: 0 (operar 24h), depois otimizar para Londres/NY overlap (10-16)
CustomStartMinute=0||0||0||59||N
CustomEndHour=23||16||0||23||N
CustomEndMinute=59||0||0||59||N
; Configuração atual: 00:00 - 23:59 (24 horas)
; Para Londres/NY overlap: CustomStartHour=10, CustomEndHour=16

; === ⚠️ CONFIGURAÇÃO DE STOP LOSS ===
SL_BufferPoints=10.0||10.0||1.000000||100.000000||N
SL_FallbackPercent=0.3||0.3||0.1||1.0||N
SL_MinDistancePoints=50.0||50.0||10.0||200.0||N
SL_MaxDistancePoints=300||500.0||100.0||2000.0||N
; 🔥 AJUSTADO: 300 pontos (30 pips) ideal para USDJPY
; v4.23: JPY tem ATR menor (50-60 pips vs 80-100 pips EUR/USD)
SL_UseStructure=true||false||0||true||N
SL_StructureCandles=50||50||20||100||N
SL_StructureStrength=2.0||2.0||1.0||5.0||N
SL_SafetyMultiplier=1.2||1.2||1.0||2.0||N

; === 🎯 CONFIGURAÇÃO DE TAKE PROFIT ===
EnablePartialTP=true||false||0||true||N
TP1_RR=2.0||1.5||0.5||5.0||N
; 🔥 v4.17: Aumentado 1.5→2.0 (+33%)
TP2_RR=4.0||3.0||1.0||10.0||N
; 🔥 v4.17: Aumentado 3.0→4.0 (+33%)
TP3_RR=6.0||5.0||2.0||20.0||N
; 🔥 v4.17: Aumentado 5.0→6.0 (+20%)
UseTP3=false||false||0||true||N
TP1_ClosePercent=30||40.0||10.0||100.0||N
; 🔥 v4.17: Reduzido 40→30 (deixar mais correr)
TP2_ClosePercent=50||40.0||10.0||100.0||N
; 🔥 v4.17: Aumentado 40→50 (fechar mais)
TP3_ClosePercent=20.0||20.0||10.0||100.0||N
TP_UseATR=true||false||0||true||N
TP1_ATRMultiplier=2.0||2.0||0.5||10.0||N
TP2_ATRMultiplier=4.0||4.0||1.0||20.0||N
TP3_ATRMultiplier=6.0||6.0||2.0||30.0||N
TP_MinRRRatio=1.2||1.2||0.5||3.0||N

; === 📈 CONFIGURAÇÃO DE TRAILING STOP ===
EnableTrailing=true||false||0||true||N
TrailingDistancePoints=200.0||200.0||50.0||1000.0||N
TrailingStepPoints=50.0||50.0||10.0||200.0||N
TrailingActivationRR=1.5||1.5||0.5||5.0||N
TrailingUseATR=true||false||0||true||Y
; 🔥 v4.15: ATIVADO (usar ATR para trailing dinâmico)
TrailingATRMultiplier=2.5||2.5||1.0||10.0||N
; 🔥 v4.15: Aumentado 2.0→2.5 (mais espaço para respirar)
TrailingStartAfterTP=true||false||0||true||N
TrailingMinProfit=0.5||0.5||0.1||5.0||N
TrailingMaxRisk=0.2||0.2||0.020000||2.000000||N

; === 🛡️ PROTEÇÕES ===
MaxSlippagePoints=30||30||5||100||N
LookbackStructureBars=80||80||20||200||N
BrokerGMTOffset=2||2||-12||12||N
MaxSpreadMultiplier=5.0||5.0||1.0||100.0||N
; Tolerante para testes, reduzir para 2.0-3.0 em produção

; === 🎯 BREAKEVEN E PROTEÇÃO DE LUCRO ===
EnableBreakeven=true||false||0||true||N
BreakevenAfterRR=1.0||1.0||0.5||3.0||N
; 🔥 v4.16: Mover BE após TP1 fechado (1.0 RR)
BreakevenPlusPoints=5.0||5.0||0.500000||50.000000||N
EnableProfitLock=true||false||0||true||N
LockProfitAfterRR=2.0||2.0||1.0||5.0||N
LockProfitPercent=50.0||50.0||10.0||100.0||N

; === 💰 CONTROLE DE RISCO AVANÇADO ===
UseAdaptiveSizing=false||false||0||true||N
WinStreakMultiplier=1.2||1.2||1.0||3.0||N
WinStreakThreshold=2||2||1||10||N
LossStreakDivisor=0.5||0.5||0.1||1.0||N
LossStreakThreshold=2||2||1||10||N
MaxPositionMultiplier=2.0||2.0||1.0||5.0||N
MaxDailyLoss=5.0||5.0||1.0||20.0||N
MaxWeeklyLoss=10.0||10.0||2.0||50.0||N
ReduceRiskAfterLoss=true||false||0||true||N
RiskReductionFactor=0.5||0.5||0.1||1.0||N
RecoveryMode=false||false||0||true||N

; === 📊 FILTRO ADX (Trending Markets) - 🔥 v4.15 ===
UseADXFilter=false||false||0||true||N
; DESABILITADO - Testar sem ADX primeiro
ADX_Period=14||14||5||50||N
ADX_MinTrend=25.0||25.0||10.0||50.0||N

; === 🎯 QUALIDADE DE SETUP (Confluência) ===
MinConfluenceScore=60||75||50||100||N
; 🔥 v4.17: Reduzido 75→60 (relaxar filtros)
RequireSupertrend=false||false||0||true||N
; 🔥 v4.17: Desabilitado (testar sem Supertrend obrigatório)
RequireADXConfirmation=false||false||0||true||N
MinADXStrength=20.0||20.0||10.0||50.0||N
RequireVolumeConfirm=false||false||0||true||N
VolumeMultiplier=1.2||1.2||1.0||3.0||N

; === 📊 CONTROLE DE POSIÇÕES ===
PositionControlMode=0||0||0||2||Y
; 0 = SINGLE (1 posição por vez)
; 1 = MULTIPLE (até MaxSimultaneousTrades)
; 2 = PROTECTED (múltiplas após lucro protegido)

; === 📁 INDICADORES - Caminhos dos Arquivos ===
IndicatorsBasePath=NexusConfluenceEA\
GGTrendBarIndicator=GG_TrendBar_Indicator
TrendMagicIndicator=TrendMagic_MT5
CurrencyStrengthIndicator=CurrencyStrengthMeter_MT5
RSIOMAIndicator=RSIOMA_v2HHLSX_MT5
WAEIndicator=WaddahAttarExplosion_Professional

; === 📈 SUPERTREND (Trend Magic Operacional) - Tendência Local ===
ST_OPER_CCI_Period=50||50||30||100||N
ST_OPER_ATR_Period=5||5||3||10||N
ST_OPER_ATR_Multiplier=1.0||1.0||0.5||3.0||N

; === 💱 CURRENCY STRENGTH - OPERACIONAL ===
CS_CalculationPeriod=24||24||12||48||N
CS_SmoothingPeriod=5||5||3||10||N
CS_ShowInPercent=true||false||0||true||N

; === 📊 RSI OMA (Operacional) - Força Relativa ===
RSI_OPER_Period=14||14||10||20||N
RSI_OPER_MA_Period=9||9||5||15||N
